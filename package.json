{
  "name": "leftovers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "reset-data": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('Cleared .data/')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
