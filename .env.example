# Copy to .env.local and fill in what you have. EVERYTHING IS OPTIONAL:
# with nothing set, the app uses a local file store (.data/) and a demo "mock" AI.

# --- AI (Claude) ---
# Get a key at https://console.anthropic.com → API keys. Server-side only.
ANTHROPIC_API_KEY=
# Optional: force "live" or "mock" (default: live if ANTHROPIC_API_KEY is set)
AI_MODE=
# Optional: override the model (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# --- Discord (optional) ---
# Announce every new post in a channel. Server-side only: NEVER prefix with NEXT_PUBLIC_
# (anyone with the URL can post to your channel). Discord → channel → Edit Channel →
# Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# --- Supabase (needed to deploy; optional locally) ---
# Supabase dashboard → Project Settings → API. NEVER prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: makes the feed update instantly via realtime (safe to expose: read-only anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
